# Copy to .env and adjust. Never commit real secrets.

# Payments: "fake" (PSP simulator, default) or "stripe" (test mode).
PAYMENT_PROVIDER=fake
# Stripe test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...), e.g. from `stripe listen --forward-to localhost:8081/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# Auth: "dev" uses the local issuer (cmd/devissuer); "auth0" uses your tenant.
AUTH_MODE=dev
OIDC_ISSUER=http://localhost:9000/
OIDC_JWKS_URL=http://devissuer:9000/.well-known/jwks.json
OIDC_AUDIENCE=orderflow-admin
OIDC_ROLES_CLAIM=https://orderflow.dev/roles
# For AUTH_MODE=auth0:
#   OIDC_ISSUER=https://<tenant>.us.auth0.com/
#   OIDC_JWKS_URL=        (empty: derived from the issuer)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# PSP simulator defaults (change at runtime with scripts/chaos.sh)
FAILURE_RATE=0.1
DECLINE_RATE=0.05
